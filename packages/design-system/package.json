{
  "name": "@django-core/design-system",
  "version": "0.0.1",
  "description": "Product-agnostic design system with design tokens, UI components, and theming infrastructure",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./tokens.css": "./dist/tokens.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "chromatic --exit-zero-on-changes",
    "chromatic:ci": "chromatic",
    "format": "prettier --write \"src/**/*.{ts,tsx,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,md}\""
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "1.9.0",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.1",
    "@storybook/addon-a11y": "8.3.5",
    "@storybook/addon-essentials": "8.3.5",
    "@storybook/addon-interactions": "8.3.5",
    "@storybook/addon-links": "8.3.5",
    "@storybook/blocks": "8.3.5",
    "@storybook/react": "8.3.5",
    "@storybook/react-vite": "8.3.5",
    "@storybook/test": "8.3.5",
    "@swc/core": "^1.15.3",
    "@swc/jest": "^0.2.39",
    "@testing-library/jest-dom": "6.5.0",
    "@testing-library/react": "16.0.1",
    "@testing-library/user-event": "14.5.2",
    "@types/jest": "29.5.13",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^24.10.1",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1",
    "@typescript-eslint/eslint-plugin": "8.8.1",
    "@typescript-eslint/parser": "8.8.1",
    "@vanilla-extract/css": "1.16.0",
    "@vanilla-extract/jest-transform": "^1.1.19",
    "@vanilla-extract/vite-plugin": "4.0.16",
    "@vitejs/plugin-react": "4.3.2",
    "chromatic": "^13.3.4",
    "eslint": "9.12.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-jsx-a11y": "6.10.0",
    "eslint-plugin-react": "7.37.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "0.4.12",
    "eslint-plugin-storybook": "0.9.0",
    "globals": "^16.5.0",
    "husky": "9.1.6",
    "identity-obj-proxy": "3.0.0",
    "jest": "29.7.0",
    "jest-axe": "9.0.0",
    "jest-environment-jsdom": "29.7.0",
    "lint-staged": "15.2.10",
    "prettier": "3.3.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "storybook": "8.3.5",
    "typescript": "5.6.2",
    "vite": "5.4.8"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.{md,json}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "design-system",
    "react",
    "typescript",
    "vanilla-extract",
    "theming",
    "components"
  ],
  "author": "Django Core Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/django-core/django-core.git",
    "directory": "packages/design-system"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.16",
    "@vanilla-extract/recipes": "^0.5.7",
    "focus-trap-react": "^11.0.4"
  }
}
