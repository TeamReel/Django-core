{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@django-core/design-system": ["../packages/design-system/src/index.ts"],
      "@django-core/context-switcher": ["../packages/context-switcher/src/index.ts"],
      "@django-core/auth-ui": ["../packages/auth/src/index.ts"],
      "@django-core/theme-system": ["../packages/theme-system/src/index.ts"],
      "@django-core/api-client": ["../packages/api-client/src/index.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["src/pages/_archive", "src/**/*.test.ts", "src/**/*.test.tsx", "src/test"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
