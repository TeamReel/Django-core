## 4. Testing Your Product

### Test Product Logic with Core Fixtures

```python
# apps/products/tests/test_models.py
import pytest
from django_core.accounts.tests.factories import UserFactory
from django_core.organisations.tests.factories import OrganisationFactory
from apps.products.models import Product

@pytest.mark.django_db
class TestProductModel:
    def test_product_creation(self):
        # Use core factories
        org = OrganisationFactory()
        user = UserFactory(active_organisation=org)

        # Test your model
        product = Product.objects.create(
            name="Test Product",
            price=99.99,
            organisation=org,
            created_by=user
        )

        assert product.name == "Test Product"
        assert product.organisation == org

    def test_organisation_cascade_delete(self):
        org = OrganisationFactory()
        product = Product.objects.create(
            name="Test",
            price=10.00,
            organisation=org
        )

        # Core behavior: cascade delete
        org.delete()
        assert not Product.objects.filter(id=product.id).exists()
```

### Test API Integration

```python
# apps/products/tests/test_api.py
import pytest
from rest_framework.test import APIClient
from django_core.accounts.tests.factories import UserFactory
from apps.products.models import Product

@pytest.mark.django_db
class TestProductAPI:
    def test_list_products_authenticated(self):
        user = UserFactory()
        client = APIClient()
        client.force_authenticate(user=user)

        # Create product in user's org
        Product.objects.create(
            name="Product 1",
            price=50.00,
            organisation=user.active_organisation
        )

        response = client.get('/api/products/')
        assert response.status_code == 200
        assert len(response.data) == 1

    def test_list_products_filters_by_organisation(self):
        # Core multi-tenancy: user only sees own org products
        user1 = UserFactory()
        user2 = UserFactory()

        Product.objects.create(
            name="User 1 Product",
            organisation=user1.active_organisation
        )
        Product.objects.create(
            name="User 2 Product",
            organisation=user2.active_organisation
        )

        client = APIClient()
        client.force_authenticate(user=user1)
        response = client.get('/api/products/')

        assert len(response.data) == 1
        assert response.data[0]['name'] == "User 1 Product"
```

