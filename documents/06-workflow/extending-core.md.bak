## 3. Extension Patterns

### Pattern A: Extend Core Models with ForeignKey

**Use Case**: Add product-specific fields while linking to core entities.

```python
# apps/products/models.py
from django.db import models
from django_core.accounts.models import User
from django_core.organisations.models import Organisation
from django_core.projects.models import Project

class Product(models.Model):
    """Your domain model linking to core entities"""
    name = models.CharField(max_length=200)
    description = models.TextField()
    price = models.DecimalField(max_digits=10, decimal_places=2)

    # Link to core multi-tenancy
    organisation = models.ForeignKey(
        Organisation,
        on_delete=models.CASCADE,
        related_name='products'
    )

    # Link to core workspaces
    project = models.ForeignKey(
        Project,
        on_delete=models.CASCADE,
        related_name='products',
        null=True, blank=True
    )

    # Link to core users
    created_by = models.ForeignKey(
        User,
        on_delete=models.SET_NULL,
        null=True
    )

    created_at = models.DateTimeField(auto_now_add=True)

    class Meta:
        # Use core permissions system (B08)
        permissions = [
            ('view_product', 'Can view product'),
            ('manage_product', 'Can manage product'),
        ]
```

### Pattern B: Extend Core API with Custom Endpoints

**Use Case**: Add product-specific API endpoints using core auth/permissions.

```python
# apps/products/serializers.py
from rest_framework import serializers
from django_core.api.serializers import BaseModelSerializer
from .models import Product

class ProductSerializer(BaseModelSerializer):
    """Inherit core patterns for consistency"""
    organisation_name = serializers.CharField(
        source='organisation.name',
        read_only=True
    )

    class Meta:
        model = Product
        fields = ['id', 'name', 'description', 'price',
                  'organisation', 'organisation_name', 'created_at']
        read_only_fields = ['created_at']

# apps/products/views.py
from rest_framework import viewsets
from django_core.api.permissions import IsAuthenticated, HasOrganisationAccess
from .models import Product
from .serializers import ProductSerializer

class ProductViewSet(viewsets.ModelViewSet):
    """Custom API using core auth/permissions"""
    serializer_class = ProductSerializer
    permission_classes = [IsAuthenticated, HasOrganisationAccess]

    def get_queryset(self):
        # Filter by user's organisation (B06)
        return Product.objects.filter(
            organisation=self.request.user.active_organisation
        )

    def perform_create(self, serializer):
        # Auto-set organisation and creator (B05, B06)
        serializer.save(
            organisation=self.request.user.active_organisation,
            created_by=self.request.user
        )

# apps/products/urls.py
from rest_framework.routers import DefaultRouter
from .views import ProductViewSet

router = DefaultRouter()
router.register(r'products', ProductViewSet, basename='product')

urlpatterns = router.urls
```

### Pattern C: Extend Core Frontend Components

**Use Case**: Build product UI using core design system and components.

```typescript
// src/features/products/ProductList.tsx
import {
  Card,
  Button,
  Table
} from '@django-core/design-system';
import { useAuth } from '@django-core/auth';
import { useApi } from '@django-core/api-client';

export function ProductList() {
  const { user } = useAuth();
  const { data: products, loading } = useApi('/api/products/');

  if (loading) return <div>Loading...</div>;

  return (
    <Card title={`Products - ${user.activeOrganisation.name}`}>
      <Table
        data={products}
        columns={[
          { key: 'name', label: 'Name' },
          { key: 'price', label: 'Price' },
          { key: 'created_at', label: 'Created' },
        ]}
      />
      <Button onClick={() => {/* Create product */}}>
        Add Product
      </Button>
    </Card>
  );
}
```

### Pattern D: Hook into Core Signals

**Use Case**: React to core events (user login, organisation created, etc.)

```python
# apps/workflows/signals.py
from django.dispatch import receiver
from django_core.accounts.signals import user_logged_in
from django_core.organisations.signals import organisation_created
from .tasks import send_welcome_email, setup_organisation_workspace

@receiver(user_logged_in)
def on_user_login(sender, user, request, **kwargs):
    """Trigger product-specific logic on login"""
    # Track analytics
    track_user_login(user)

    # Check product-specific conditions
    if not user.has_completed_onboarding:
        send_onboarding_reminder.delay(user.id)

@receiver(organisation_created)
def on_organisation_created(sender, organisation, **kwargs):
    """Setup product workspace when org created"""
    setup_organisation_workspace.delay(organisation.id)
    send_welcome_email.delay(organisation.owner.email)

# apps/workflows/apps.py
from django.apps import AppConfig

class WorkflowsConfig(AppConfig):
    name = 'apps.workflows'

    def ready(self):
        import apps.workflows.signals  # Register signal handlers
```

### Pattern E: Override Core Templates

**Use Case**: Customize core UI while keeping functionality.

```python
# config/settings.py
TEMPLATES = [
    {
        'BACKEND': 'django.template.backends.django.DjangoTemplates',
        'DIRS': [
            # Your templates override core templates
            BASE_DIR / 'templates',
        ],
        'APP_DIRS': True,
        'OPTIONS': {
            'context_processors': [
                # Core context processors
                'django_core.web_ui.context_processors.core_context',
                # Your custom processors
                'apps.common.context_processors.product_context',
            ],
        },
    },
]
```

**templates/auth/login.html** (overrides core):
```html
{% extends "django_core/auth/base.html" %}

{% block extra_head %}
<link rel="stylesheet" href="{% static 'css/product-branding.css' %}">
{% endblock %}

{% block content %}
<div class="product-login">
  <img src="{% static 'images/product-logo.png' %}" alt="Logo">
  {% include "django_core/auth/_login_form.html" %}
</div>
{% endblock %}
```

