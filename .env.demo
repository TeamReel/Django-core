# Environment Variables for Demo Profile
# 032-demo-production-database (WP03)
#
# Purpose: Configuration template for demo and demo-lite profiles
# Usage: Copy to .env.demo.local and customize as needed
#
# Quick Start:
#   cp .env.demo .env.demo.local
#   docker-compose -f docker-compose.demo.yml --profile demo up

# =============================================================================
# Demo Profile Selection
# =============================================================================

# Profile type (affects which services start)
# Values: demo (PostgreSQL + auto-seed), demo-lite (SQLite + manual seed)
# Note: Set via --profile flag, not here
# DEMO_PROFILE=demo

# =============================================================================
# Database Configuration
# =============================================================================

# PostgreSQL settings (demo profile only)
DEMO_DB_NAME=django_core_demo
DEMO_DB_USER=demo
DEMO_DB_PASSWORD=Demo2024!
DEMO_DB_PORT=5433  # Avoid conflict with local dev (5432)

# Connection pooling (pgbouncer-ready)
# CONN_MAX_AGE: Connection lifetime in seconds (0=disabled, recommended 600)
# DB_POOL_PRE_PING: Test connection before use (True recommended for pooling)
CONN_MAX_AGE=600
DB_POOL_PRE_PING=True

# Read replica configuration (FUTURE - settings template only)
# Uncomment when read replica is deployed in production
# DATABASE_URL_READONLY=postgresql://demo_ro:ReadOnly2024!@db-replica:5432/django_core_demo
# READ_REPLICA_ENABLED=False  # Set to True when replica available

# =============================================================================
# Redis Configuration
# =============================================================================

DEMO_REDIS_PORT=6380  # Avoid conflict with local dev (6379)

# =============================================================================
# Demo Behavior
# =============================================================================

# Auto-seed on startup (demo profile only)
# Values: true (seed automatically), false (manual seed required)
DEMO_AUTO_SEED=true

# Reset data on every startup (DANGEROUS - testing only)
# Values: true (wipe and reseed), false (preserve existing data)
# ⚠️  WARNING: Setting this to true will DELETE ALL DATA on every restart!
DEMO_RESET_ON_START=false

# Random seed for deterministic data generation
# Values: any integer (42, 12345, etc.), default (random seed)
# Use same seed for reproducible test scenarios
DEMO_RANDOM_SEED=12345

# =============================================================================
# Application Settings
# =============================================================================

# Debug mode (enables detailed error pages, SQL logging)
# Values: True, False
# Recommended: True for demo, False for production
DEMO_DEBUG=True

# Secret key (generate unique key for each environment)
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=demo-secret-key-please-change-in-production-use-50-plus-characters

# Port mappings
DEMO_WEB_PORT=8080      # Demo profile web port
DEMO_LITE_WEB_PORT=8081 # Demo-lite profile web port

# Logging level
# Values: DEBUG, INFO, WARNING, ERROR, CRITICAL
DEMO_LOGGING_LEVEL=INFO

# =============================================================================
# pgbouncer Configuration (FUTURE - when pooling service added)
# =============================================================================

# Uncomment and configure when pgbouncer service is added to docker-compose.demo.yml
# PGBOUNCER_ENABLED=False
# PGBOUNCER_PORT=6432
# PGBOUNCER_POOL_MODE=session  # session, transaction, or statement
# PGBOUNCER_MAX_CLIENT_CONN=100
# PGBOUNCER_DEFAULT_POOL_SIZE=25
# PGBOUNCER_RESERVE_POOL_SIZE=5
# PGBOUNCER_SERVER_IDLE_TIMEOUT=600

# When pgbouncer is enabled, update DATABASE_URL:
# DATABASE_URL=postgresql://demo:Demo2024!@pgbouncer:6432/django_core_demo

# =============================================================================
# Django DATABASES Configuration Template (settings.py)
# =============================================================================

# This section documents the Django settings structure for production deployments
# with read replicas. For demo profile, only primary database is active.
#
# DATABASES = {
#     'default': {
#         'ENGINE': 'django.db.backends.postgresql',
#         'NAME': os.getenv('DEMO_DB_NAME', 'django_core_demo'),
#         'USER': os.getenv('DEMO_DB_USER', 'demo'),
#         'PASSWORD': os.getenv('DEMO_DB_PASSWORD'),
#         'HOST': os.getenv('DEMO_DB_HOST', 'db-demo'),
#         'PORT': os.getenv('DEMO_DB_PORT', '5432'),
#         'CONN_MAX_AGE': int(os.getenv('CONN_MAX_AGE', 600)),
#         'OPTIONS': {
#             'connect_timeout': 10,
#             'options': '-c statement_timeout=30000',  # 30s query timeout
#         },
#     },
#     'read_replica': {
#         'ENGINE': 'django.db.backends.postgresql',
#         'NAME': os.getenv('DEMO_DB_NAME', 'django_core_demo'),
#         'USER': os.getenv('DEMO_DB_READONLY_USER', 'demo_ro'),
#         'PASSWORD': os.getenv('DEMO_DB_READONLY_PASSWORD'),
#         'HOST': os.getenv('DEMO_DB_READONLY_HOST', 'db-replica'),
#         'PORT': os.getenv('DEMO_DB_READONLY_PORT', '5432'),
#         'CONN_MAX_AGE': int(os.getenv('CONN_MAX_AGE', 600)),
#         'OPTIONS': {
#             'connect_timeout': 10,
#             'options': '-c statement_timeout=30000',
#         },
#     },
# }
#
# DATABASE_ROUTERS = ['config.routers.ReadReplicaRouter']  # Route reads to replica
#
# Note: Read replica is a future production optimization. Demo profile uses
# single primary database only. Replica configuration is template for reference.

# =============================================================================
# Expected Dataset (after seed)
# =============================================================================

# Demo data counts (for verification):
# - 5 organizations (TechVentures, DataLab Innovations, DevOps Guild, CloudStream Solutions, Agile Consulting Group)
# - 20 users (4 per org: 1 admin, 1 manager, 1 member, 1 viewer)
# - 80 projects (15/30/10/5/20 per org, ~80% active, ~20% archived)
# - 200-300 audit events (seeded range, various types)
# - Transactions over last 30 days (purchase/usage/refund mix)
# - Notifications: 5-10 unread per demo account, 50+ read per org
#
# Demo accounts (all passwords: Demo2024!):
# - admin@demo.djangocore.app (Superuser)
# - admin@{org}.djangocore.app (Org admins, 5 total)
# - manager@{org}.djangocore.app (Managers, 5 total)
# - user@{org}.djangocore.app (Members, 5 total)
# - viewer@{org}.djangocore.app (Viewers, 5 total)

# =============================================================================
# Verification Checklist
# =============================================================================

# After starting demo profile, verify:
# 1. Web accessible at http://localhost:8080 (or DEMO_WEB_PORT)
# 2. Login as admin@demo.djangocore.app (Demo2024!)
# 3. Dashboard shows 5 organizations
# 4. Projects page shows 80 projects total
# 5. Audit log shows 200-300 events
# 6. Notifications show 5-10 unread items
# 7. Run: docker exec -it <web-container> python manage.py validate_demo_data
# 8. Validation passes with 0 violations

# Performance targets:
# - Demo profile startup: <60s (includes migrations + seed)
# - Demo-lite profile startup: <30s (no seed, SQLite faster)
# - Seed command (first run): <30s
# - Seed command (rerun with data): <5s (idempotent check)
# - Database size after seed: ~50MB
