# Environment Variables Template
# B19 Deployment Templates & Configuration
#
# Copy this file to .env and fill in the values
# NEVER commit .env file to version control!

# =============================================================================
# Django Core Settings
# =============================================================================

# Secret key for cryptographic signing (REQUIRED)
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here-50-plus-characters

# Debug mode (NEVER True in production)
# Values: True, False
DEBUG=False

# Allowed hostnames (comma-separated)
# Example: example.com,www.example.com,api.example.com
ALLOWED_HOSTS=localhost,127.0.0.1

# CSRF trusted origins (comma-separated HTTPS origins)
# Example: https://example.com,https://www.example.com
CSRF_TRUSTED_ORIGINS=http://localhost

# =============================================================================
# Database Configuration
# =============================================================================

# PostgreSQL connection URL (REQUIRED)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
#
# Local development:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/django_core_dev
#
# AWS RDS example:
# DATABASE_URL=postgresql://dbuser:dbpassword@mydb.abc123.us-east-1.rds.amazonaws.com:5432/django_core
#
# GCP Cloud SQL example:
# DATABASE_URL=postgresql://dbuser:dbpassword@/django_core?host=/cloudsql/PROJECT:REGION:INSTANCE
#
# Azure PostgreSQL example:
# DATABASE_URL=postgresql://dbuser@servername:dbpassword@servername.postgres.database.azure.com:5432/django_core?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@db:5432/django_core_dev

# =============================================================================
# Redis Configuration (Cache & Celery Broker)
# =============================================================================

# Redis connection URL (REQUIRED)
# Format: redis://[:PASSWORD@]HOST:PORT/DB
#
# Local development:
# REDIS_URL=redis://localhost:6379/0
#
# AWS ElastiCache example:
# REDIS_URL=redis://:password@my-redis.abc123.0001.use1.cache.amazonaws.com:6379/0
#
# GCP Memorystore example:
# REDIS_URL=redis://10.0.0.3:6379/0
#
# Azure Cache for Redis example:
# REDIS_URL=redis://:password@myredis.redis.cache.windows.net:6380/0?ssl_cert_reqs=required
REDIS_URL=redis://redis:6379/0

# =============================================================================
# Celery Configuration (B15 Task Scheduling)
# =============================================================================

# Celery broker URL (typically same as REDIS_URL)
CELERY_BROKER_URL=redis://redis:6379/0

# Celery result backend (optional, can use Redis or database)
# Leave empty to disable result backend
CELERY_RESULT_BACKEND=

# Run tasks synchronously (development only, NEVER in production)
# Values: True, False
CELERY_TASK_ALWAYS_EAGER=False

# Worker concurrency (number of worker threads/processes)
# Recommendation: (2 * CPU_CORES) + 1
CELERY_WORKER_CONCURRENCY=4

# Task soft time limit (seconds before warning)
CELERY_TASK_SOFT_TIME_LIMIT=300

# Task hard time limit (seconds before termination)
CELERY_TASK_TIME_LIMIT=600

# =============================================================================
# Security Settings (B03 Security Baseline)
# =============================================================================

# Force HTTPS redirect (production only)
# Values: True, False
SECURE_SSL_REDIRECT=False

# Secure session cookies (requires HTTPS)
# Values: True, False
SESSION_COOKIE_SECURE=False

# Secure CSRF cookies (requires HTTPS)
# Values: True, False
CSRF_COOKIE_SECURE=False

# HTTP Strict Transport Security duration (seconds)
# Recommended: 31536000 (1 year) for production
SECURE_HSTS_SECONDS=0

# Include subdomains in HSTS
# Values: True, False
SECURE_HSTS_INCLUDE_SUBDOMAINS=False

# =============================================================================
# Logging & Observability (B18 Platform Observability)
# =============================================================================

# Logging level
# Values: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOGGING_LEVEL=INFO

# Enable Prometheus metrics endpoint (/metrics)
# Values: True, False
PROMETHEUS_METRICS_ENABLED=True

# Sentry error tracking DSN (optional)
# Get from: https://sentry.io/settings/projects/
SENTRY_DSN=

# =============================================================================
# Docker Compose Configuration (for docker-compose.*.yml files)
# =============================================================================

# Docker image tag (production only)
# Example: myregistry.com/django-core:1.0.0
DOCKER_IMAGE=django-core:latest

# Database credentials (for docker-compose with local PostgreSQL)
DATABASE_NAME=django_core_dev
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# Redis password (for docker-compose with local Redis)
REDIS_PASSWORD=

# Gunicorn workers (production)
# Recommendation: (2 * CPU_CORES) + 1
GUNICORN_WORKERS=4

# Celery worker replicas (production Docker Compose)
CELERY_WORKER_REPLICAS=2

# SSL certificate path (production Nginx)
SSL_CERT_PATH=./ssl

# =============================================================================
# Cloud Provider Examples
# =============================================================================

# AWS RDS PostgreSQL:
# DATABASE_URL=postgresql://admin:password@django-db.abc123.us-east-1.rds.amazonaws.com:5432/django_core
#
# AWS ElastiCache Redis:
# REDIS_URL=redis://:password@django-cache.abc123.0001.use1.cache.amazonaws.com:6379/0
#
# AWS S3 (for static/media files - future enhancement):
# AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# AWS_STORAGE_BUCKET_NAME=django-core-static
# AWS_S3_REGION_NAME=us-east-1

# GCP Cloud SQL PostgreSQL:
# DATABASE_URL=postgresql://postgres:password@/django_core?host=/cloudsql/project-id:us-central1:django-db
#
# GCP Memorystore Redis:
# REDIS_URL=redis://10.0.0.3:6379/0
#
# GCP Cloud Storage (for static/media files - future enhancement):
# GS_BUCKET_NAME=django-core-static
# GS_PROJECT_ID=project-id
# GS_CREDENTIALS=/path/to/service-account-key.json

# Azure PostgreSQL:
# DATABASE_URL=postgresql://admin@servername:password@servername.postgres.database.azure.com:5432/django_core?sslmode=require
#
# Azure Cache for Redis:
# REDIS_URL=redis://:password@django-cache.redis.cache.windows.net:6380/0?ssl_cert_reqs=required
#
# Azure Blob Storage (for static/media files - future enhancement):
# AZURE_ACCOUNT_NAME=djangocorestatic
# AZURE_ACCOUNT_KEY=your-account-key
# AZURE_CONTAINER=static

# =============================================================================
# Validation Rules
# =============================================================================
#
# SECRET_KEY:
#   - Required: Yes
#   - Format: 50+ alphanumeric characters
#   - Security: Never commit to version control, rotate periodically
#
# DATABASE_URL:
#   - Required: Yes
#   - Format: postgresql://user:password@host:port/database
#   - Validation: Must be valid PostgreSQL connection string
#
# REDIS_URL:
#   - Required: Yes
#   - Format: redis://[:password@]host:port/db
#   - Validation: Must be valid Redis connection string
#
# ALLOWED_HOSTS:
#   - Required: Yes (unless DEBUG=True)
#   - Format: Comma-separated hostnames (no spaces)
#   - Example: example.com,www.example.com
#
# CSRF_TRUSTED_ORIGINS:
#   - Required: Yes (for POST requests from external origins)
#   - Format: Comma-separated HTTPS origins (no spaces)
#   - Example: https://example.com,https://www.example.com
#
# SECURE_SSL_REDIRECT:
#   - Production: True (requires HTTPS)
#   - Development: False
#
# SESSION_COOKIE_SECURE / CSRF_COOKIE_SECURE:
#   - Production: True (requires HTTPS)
#   - Development: False
#
# LOGGING_LEVEL:
#   - Production: INFO or WARNING
#   - Development: DEBUG
#   - Values: DEBUG, INFO, WARNING, ERROR, CRITICAL
#
# CELERY_TASK_ALWAYS_EAGER:
#   - Production: False (tasks run asynchronously)
#   - Development: True or False (True for simpler debugging)
