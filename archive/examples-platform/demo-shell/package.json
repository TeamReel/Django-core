    "lint": "eslint src --ext ts,tsx",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@django-core/api-client": "workspace:*",
    "@django-core/auth-ui": "workspace:*",
    "@django-core/context-switcher": "workspace:*",
