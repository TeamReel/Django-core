    "@django-core/notifications-hub": "workspace:*",
    "@django-core/page-templates": "workspace:*",
    "@django-core/permissions": "workspace:*",
    "@django-core/resource-alerts": "workspace:*",
    "@django-core/theme-system": "workspace:*",
    "chart.js": "^4.4.0",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "recharts": "^2.10.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vanilla-extract/css": "^1.18.0",
    "@vanilla-extract/vite-plugin": "^5.1.4",
    "@vitejs/plugin-react": "^4.2.0",
    "typescript": "^5.3.0",
