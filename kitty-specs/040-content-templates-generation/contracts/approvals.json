{
  "endpoint": "/api/v1/content-generation/approvals/",
  "description": "Content approval workflow",
  "authentication": "Required (B08 permissions)",
  "operations": [
    {
      "method": "GET",
      "path": "/api/v1/content-generation/approvals/",
      "summary": "List approval records (audit trail)",
      "permission": "content_generation.approve_content",
      "query_parameters": [
        {
          "name": "content_item",
          "type": "integer",
          "required": false,
          "description": "Filter by content item ID"
        },
        {
          "name": "status",
          "type": "string",
          "required": false,
          "description": "Filter by approval status (pending, approved, rejected, revision_requested)"
        },
        {
          "name": "reviewer",
          "type": "integer",
          "required": false,
          "description": "Filter by reviewer user ID"
        }
      ],
      "response_200": {
        "count": 50,
        "next": null,
        "previous": null,
        "results": [
          {
            "id": 1,
            "content_item": {
              "id": 42,
              "template": {"id": 1, "name": "Line-up Video"}
            },
            "reviewer": {
              "id": 20,
              "username": "admin_jones"
            },
            "status": "approved",
            "feedback_text": "Excellent work, ready to publish",
            "reviewed_at": "2026-01-28T14:45:00Z"
          }
        ]
      }
    },
    {
      "method": "POST",
      "path": "/api/v1/content-generation/approvals/",
      "summary": "Create approval decision",
      "permission": "content_generation.approve_content",
      "request_body": {
        "content_item": 42,
        "status": "approved",
        "feedback_text": "Looks perfect, approved for publication"
      },
      "response_201": {
        "id": 2,
        "content_item": 42,
        "reviewer": 20,
        "status": "approved",
        "feedback_text": "Looks perfect, approved for publication",
        "reviewed_at": "2026-01-29T10:30:00Z"
      },
      "response_400": {
        "error": "Validation error",
        "details": {
          "content_item": ["Content item must be in 'completed' status to approve"],
          "status": ["Feedback text is required for rejected/revision_requested status"]
        }
      },
      "response_403": {
        "error": "Self-approval is not allowed (configured via B10 feature flag)"
      }
    },
    {
      "method": "GET",
      "path": "/api/v1/content-generation/approvals/{id}/",
      "summary": "Retrieve approval detail",
      "permission": "content_generation.approve_content",
      "response_200": {
        "id": 1,
        "content_item": {"...": "..."},
        "reviewer": {"...": "..."},
        "status": "approved",
        "feedback_text": "...",
        "reviewed_at": "2026-01-28T14:45:00Z"
      }
    },
    {
      "method": "POST",
      "path": "/api/v1/content-generation/items/{id}/approve/",
      "summary": "Approve content item (shortcut)",
      "permission": "content_generation.approve_content",
      "custom_action": true,
      "request_body": {
        "feedback_text": "Approved for publication"
      },
      "response_200": {
        "id": 42,
        "status": "approved",
        "approval": {
          "id": 3,
          "reviewer": 20,
          "status": "approved",
          "feedback_text": "Approved for publication",
          "reviewed_at": "2026-01-29T11:00:00Z"
        }
      }
    },
    {
      "method": "POST",
      "path": "/api/v1/content-generation/items/{id}/reject/",
      "summary": "Reject content item (shortcut)",
      "permission": "content_generation.approve_content",
      "custom_action": true,
      "request_body": {
        "feedback_text": "Quality is not acceptable, please regenerate with higher resolution"
      },
      "response_200": {
        "id": 42,
        "status": "rejected",
        "approval": {
          "id": 4,
          "reviewer": 20,
          "status": "rejected",
          "feedback_text": "Quality is not acceptable, please regenerate with higher resolution",
          "reviewed_at": "2026-01-29T11:05:00Z"
        }
      },
      "response_400": {
        "error": "Feedback text is required for rejection"
      }
    },
    {
      "method": "POST",
      "path": "/api/v1/content-generation/items/{id}/request-revision/",
      "summary": "Request content revision (shortcut)",
      "permission": "content_generation.approve_content",
      "custom_action": true,
      "request_body": {
        "feedback_text": "Please adjust the timing of the transition at 0:45"
      },
      "response_200": {
        "id": 42,
        "status": "revision_requested",
        "approval": {
          "id": 5,
          "reviewer": 20,
          "status": "revision_requested",
          "feedback_text": "Please adjust the timing of the transition at 0:45",
          "reviewed_at": "2026-01-29T11:10:00Z"
        }
      }
    }
  ]
