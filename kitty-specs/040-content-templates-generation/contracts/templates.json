{
  "endpoint": "/api/v1/content-generation/templates/",
  "description": "Content template management",
  "authentication": "Required (B08 permissions)",
  "operations": [
    {
      "method": "GET",
      "path": "/api/v1/content-generation/templates/",
      "summary": "List templates",
      "permission": "content_generation.view_library (implicit for list)",
      "query_parameters": [
        {
          "name": "sport_type",
          "type": "string",
          "required": false,
          "description": "Filter by sport (e.g., 'football')"
        },
        {
          "name": "is_active",
          "type": "boolean",
          "required": false,
          "description": "Filter by active status (default: true)"
        },
        {
          "name": "project",
          "type": "integer",
          "required": false,
          "description": "Filter by project ID"
        }
      ],
      "response_200": {
        "count": 2,
        "next": null,
        "previous": null,
        "results": [
          {
            "id": 1,
            "name": "Line-up Video",
            "description": "Generate video with starting line-up",
            "template_type": "pre_match",
            "sport_type": "football",
            "ai_workflow_id": "workflow_lineup_v2",
            "timeout_minutes": 15,
            "is_active": true,
            "organisation": 1,
            "project": null,
            "created_by": 10,
            "created_at": "2026-01-20T10:00:00Z",
            "updated_at": "2026-01-20T10:00:00Z"
          }
        ]
      }
    },
    {
      "method": "POST",
      "path": "/api/v1/content-generation/templates/",
      "summary": "Create template",
      "permission": "content_generation.manage_templates",
      "request_body": {
        "name": "Match Highlights",
        "description": "Generate 90-second highlight reel",
        "template_type": "post_match",
        "sport_type": "football",
        "ai_workflow_id": "workflow_highlights_v3",
        "template_settings": {
          "duration_seconds": 90,
          "include_goals": true,
          "include_cards": true
        },
        "timeout_minutes": 30,
        "is_active": true,
        "organisation": 1,
        "project": null
      },
      "response_201": {
        "id": 2,
        "name": "Match Highlights",
        "template_type": "post_match",
        "...": "..."
      },
      "response_400": {
        "error": "Validation error",
        "details": {
          "name": ["Template with this name already exists for this organisation"]
        }
      }
    },
    {
      "method": "GET",
      "path": "/api/v1/content-generation/templates/{id}/",
      "summary": "Retrieve template detail",
      "permission": "content_generation.view_library",
      "response_200": {
        "id": 1,
        "name": "Line-up Video",
        "...": "..."
      }
    },
    {
      "method": "PATCH",
      "path": "/api/v1/content-generation/templates/{id}/",
      "summary": "Partial update template",
      "permission": "content_generation.manage_templates",
      "request_body": {
        "is_active": false
      },
      "response_200": {
        "id": 1,
        "is_active": false,
        "...": "..."
      }
    },
    {
      "method": "DELETE",
      "path": "/api/v1/content-generation/templates/{id}/",
      "summary": "Delete template (soft delete if items exist)",
      "permission": "content_generation.manage_templates",
      "response_204": "No content",
      "response_400": {
        "error": "Cannot delete template with existing content items"
      }
    }
  ]
}
