{
  "endpoint": "/api/v1/content-generation/items/",
  "description": "Content item generation and library",
  "authentication": "Required (B08 permissions)",
  "operations": [
    {
      "method": "GET",
      "path": "/api/v1/content-generation/items/",
      "summary": "List content items (library)",
      "permission": "content_generation.view_library",
      "query_parameters": [
        {
          "name": "project",
          "type": "integer",
          "required": false,
          "description": "Filter by project ID (default: user's active project)"
        },
        {
          "name": "status",
          "type": "string",
          "required": false,
          "description": "Filter by status (queued, generating, completed, failed, approved, rejected)"
        },
        {
          "name": "template",
          "type": "integer",
          "required": false,
          "description": "Filter by template ID"
        },
        {
          "name": "activity",
          "type": "integer",
          "required": false,
          "description": "Filter by activity ID"
        },
        {
          "name": "page",
          "type": "integer",
          "required": false,
          "description": "Page number (default: 1, page size: 50)"
        }
      ],
      "response_200": {
        "count": 150,
        "next": "/api/v1/content-generation/items/?page=2",
        "previous": null,
        "results": [
          {
            "id": 42,
            "template": {
              "id": 1,
              "name": "Line-up Video"
            },
            "project": 5,
            "activity": {
              "id": 123,
              "name": "Match vs Team B"
            },
            "status": "approved",
            "output_file": {
              "id": 789,
              "url": "https://files.example.com/content/42.mp4",
              "thumbnail_url": "https://files.example.com/thumbnails/42.jpg",
              "file_size": 15728640,
              "mime_type": "video/mp4"
            },
            "created_by": {
              "id": 10,
              "username": "coach_smith"
            },
            "created_at": "2026-01-28T14:30:00Z",
            "updated_at": "2026-01-28T14:45:00Z"
          }
        ]
      }
    },
    {
      "method": "POST",
      "path": "/api/v1/content-generation/items/",
      "summary": "Create content item (queue generation)",
      "permission": "content_generation.generate_content",
      "request_body": {
        "template": 1,
        "project": 5,
        "activity": 123,
        "input_data": {
          "formation": "4-3-3",
          "players": [
            {"number": 1, "name": "Goalkeeper"},
            {"number": 10, "name": "Striker"}
          ]
        }
      },
      "response_201": {
        "id": 43,
        "template": 1,
        "project": 5,
        "activity": 123,
        "status": "queued",
        "input_data": {"...": "..."},
        "output_file": null,
        "error_message": null,
        "created_by": 10,
        "created_at": "2026-01-29T10:00:00Z",
        "updated_at": "2026-01-29T10:00:00Z"
      },
      "response_200_warning": {
        "warning": "A generation for this template and activity is already in progress",
        "existing_item_id": 42,
        "existing_status": "generating",
        "proceed": true
      },
      "response_400": {
        "error": "Validation error",
        "details": {
          "template": ["Template is not active"],
          "input_data": ["Missing required field: formation"]
        }
      }
    },
    {
      "method": "GET",
      "path": "/api/v1/content-generation/items/{id}/",
      "summary": "Retrieve content item detail",
      "permission": "content_generation.view_library",
      "response_200": {
        "id": 42,
        "template": {"id": 1, "name": "Line-up Video"},
        "project": 5,
        "activity": {"id": 123, "name": "Match vs Team B"},
        "status": "approved",
        "input_data": {"...": "..."},
        "output_file": {"...": "..."},
        "error_message": null,
        "metadata": {
          "generation_duration_seconds": 142,
          "retry_count": 0
        },
        "created_by": {"id": 10, "username": "coach_smith"},
        "created_at": "2026-01-28T14:30:00Z",
        "updated_at": "2026-01-28T14:45:00Z",
        "approval_history": [
          {
            "id": 1,
            "reviewer": {"id": 20, "username": "admin_jones"},
            "status": "approved",
            "feedback_text": "Looks great!",
            "reviewed_at": "2026-01-28T14:45:00Z"
          }
        ]
      }
    },
    {
      "method": "POST",
      "path": "/api/v1/content-generation/items/{id}/retry/",
      "summary": "Retry failed generation",
      "permission": "content_generation.generate_content",
      "custom_action": true,
      "response_200": {
        "id": 42,
        "status": "queued",
        "message": "Generation re-queued"
      },
      "response_400": {
        "error": "Cannot retry content item with status 'approved'"
      }
    },
    {
      "method": "GET",
      "path": "/api/v1/content-generation/items/{id}/status/",
      "summary": "Get current generation status (for polling)",
      "permission": "content_generation.view_library",
      "custom_action": true,
      "response_200": {
        "id": 42,
        "status": "generating",
        "progress_percent": 65,
        "estimated_completion_seconds": 45
      }
    },
    {
      "method": "DELETE",
      "path": "/api/v1/content-generation/items/{id}/",
      "summary": "Soft delete content item",
      "permission": "content_generation.manage_templates (admin only)",
      "response_204": "No content (soft deleted)",
      "response_400": {
        "error": "Cannot delete content item in status 'generating'"
      }
    }
  ]
}
