{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Success Response Envelope",
  "description": "Standard success response format for all API endpoints",
  "type": "object",
  "required": ["status", "data"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["success"],
      "description": "Response status indicator"
    },
    "data": {
      "description": "Actual response payload (can be object, array, null)",
      "oneOf": [
        {"type": "object"},
        {"type": "array"},
        {"type": "null"}
      ]
    },
    "meta": {
      "type": "object",
      "description": "Optional metadata (pagination, timestamps, etc.)",
      "properties": {
        "pagination": {
          "type": "object",
          "properties": {
            "count": {"type": "integer", "description": "Total number of items"},
            "next": {"type": ["string", "null"], "description": "URL to next page"},
            "previous": {"type": ["string", "null"], "description": "URL to previous page"},
            "page_size": {"type": "integer", "description": "Items per page"}
          }
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of response generation"
        }
      }
    }
  },
  "examples": [
    {
      "description": "Single resource response",
      "value": {
        "status": "success",
        "data": {
          "id": 123,
          "name": "Example Organisation",
          "slug": "example-org",
          "created_at": "2025-01-15T10:30:00Z"
        }
      }
    },
    {
      "description": "List response with pagination",
      "value": {
        "status": "success",
        "data": [
          {
            "id": 1,
            "name": "Project Alpha",
            "organisation": 123
          },
          {
            "id": 2,
            "name": "Project Beta",
            "organisation": 123
          }
        ],
        "meta": {
          "pagination": {
            "count": 42,
            "next": "https://api.example.com/api/v1/projects/?page=2",
            "previous": null,
            "page_size": 20
          },
          "timestamp": "2025-01-15T10:30:00Z"
        }
      }
    },
    {
      "description": "Empty list response",
      "value": {
        "status": "success",
        "data": [],
        "meta": {
          "pagination": {
            "count": 0,
            "next": null,
            "previous": null,
            "page_size": 20
          }
        }
      }
    },
    {
      "description": "Action response with no data",
      "value": {
        "status": "success",
        "data": null
      }
    }
  ]
}
