@pytest.mark.django_db
class Test{{ service_name | default("ItemService") }}GetOperations:
    """Test {{ service_name | default("ItemService") }} read operations."""

    def test_get_all_items(self):
        """Test retrieving all items."""
        Item.objects.create(name="Item 1")
        Item.objects.create(name="Item 2")

        items = {{ service_name | default("ItemService") }}.get_all()
        assert items.count() == 2

    def test_get_all_active_only(self):
        """Test retrieving only active items."""
        Item.objects.create(name="Active", is_active=True)
        Item.objects.create(name="Inactive", is_active=False)

        items = {{ service_name | default("ItemService") }}.get_all(active_only=True)
        assert items.count() == 1
        assert items.first().name == "Active"

    def test_get_by_id_existing(self):
        """Test retrieving item by ID."""
        item = Item.objects.create(name="Test Item")
        
        found = {{ service_name | default("ItemService") }}.get_by_id(item.id)
        assert found is not None
        assert found.id == item.id
        assert found.name == "Test Item"

    def test_get_by_id_nonexistent(self):
        """Test retrieving non-existent item returns None."""
        found = {{ service_name | default("ItemService") }}.get_by_id(9999)
        assert found is None


