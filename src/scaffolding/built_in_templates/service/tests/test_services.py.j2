@pytest.mark.django_db
class Test{{ service_name | default("ItemService") }}ActivationOperations:
    """Test {{ service_name | default("ItemService") }} activation/deactivation."""

    def test_activate_item(self):
        """Test activating inactive item."""
        item = Item.objects.create(name="Inactive", is_active=False)
        
        activated = {{ service_name | default("ItemService") }}.activate(item.id)
        
        assert activated.is_active is True
        item.refresh_from_db()
        assert item.is_active is True

    def test_deactivate_item(self):
        """Test deactivating active item."""
        item = Item.objects.create(name="Active", is_active=True)
        
        deactivated = {{ service_name | default("ItemService") }}.deactivate(item.id)
        
        assert deactivated.is_active is False
        item.refresh_from_db()
        assert item.is_active is False

    def test_activate_nonexistent_item(self):
        """Test activating non-existent item raises error."""
        with pytest.raises({{ app_name | title | replace('_', '') }}BusinessError, match="not found"):
            {{ service_name | default("ItemService") }}.activate(9999)

    def test_bulk_activate_items(self):
        """Test bulk activation of multiple items."""
        item1 = Item.objects.create(name="Item 1", is_active=False)
        item2 = Item.objects.create(name="Item 2", is_active=False)
        item3 = Item.objects.create(name="Item 3", is_active=False)

        count = {{ service_name | default("ItemService") }}.bulk_activate([item1.id, item2.id, item3.id])
        
        assert count == 3
        assert Item.objects.filter(is_active=True).count() == 3

    def test_bulk_deactivate_items(self):
        """Test bulk deactivation of multiple items."""
        item1 = Item.objects.create(name="Item 1", is_active=True)
        item2 = Item.objects.create(name="Item 2", is_active=True)

        count = {{ service_name | default("ItemService") }}.bulk_deactivate([item1.id, item2.id])
        
        assert count == 2
        assert Item.objects.filter(is_active=False).count() == 2


@pytest.mark.django_db
class Test{{ service_name | default("ItemService") }}Transactions:
    """Test {{ service_name | default("ItemService") }} transaction handling."""

    def test_create_rollback_on_error(self):
        """Test transaction rollback when create fails."""
        initial_count = Item.objects.count()

        # This should raise an error and rollback
        with pytest.raises({{ app_name | title | replace('_', '') }}ValidationError):
            {{ service_name | default("ItemService") }}.create(name="ab")  # Too short

        # Count should be unchanged (transaction rolled back)
        assert Item.objects.count() == initial_count

    def test_update_rollback_on_error(self):
        """Test transaction rollback when update fails."""
        item = Item.objects.create(name="Original")
        original_name = item.name

        # This should raise an error and rollback
        with pytest.raises({{ app_name | title | replace('_', '') }}ValidationError):
            {{ service_name | default("ItemService") }}.update(item.id, name="x")  # Too short

        # Name should be unchanged (transaction rolled back)
        item.refresh_from_db()
        assert item.name == original_name
