class {{ model_name | default("Item") }}ListView(LoginRequiredMixin, ListView):
    """List view for {{ model_name | default("Item") }}s."""

    model = {{ model_name | default("Item") }}
    template_name = "{{ app_name }}/{{ model_name | default('item') | lower }}_list.html"
    context_object_name = "{{ model_name | default('items') | lower }}"
    paginate_by = 20

    def get_queryset(self):
        """Filter queryset based on query parameters."""
        queryset = super().get_queryset()
        
        # Filter by active status
        is_active = self.request.GET.get("is_active")
        if is_active:
            queryset = queryset.filter(is_active=is_active.lower() == "true")
        
        # Search by name
        search = self.request.GET.get("search")
        if search:
            queryset = queryset.filter(name__icontains=search)
        
        return queryset


