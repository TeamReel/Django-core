class {{ model_name | default("Item") }}UpdateView(LoginRequiredMixin, UpdateView):
    """Update view for {{ model_name | default("Item") }}."""

    model = {{ model_name | default("Item") }}
    form_class = {{ model_name | default("Item") }}Form
    template_name = "{{ app_name }}/{{ model_name | default('item') | lower }}_form.html"
    context_object_name = "{{ model_name | default('item') | lower }}"

    def get_success_url(self):
        """Return URL to redirect after successful update."""
        return reverse_lazy("{{ app_name }}:{{ model_name | default('item') | lower }}-detail", kwargs={"pk": self.object.pk})

    def form_valid(self, form):
        """Handle successful form submission."""
        response = super().form_valid(form)
        messages.success(
            self.request,
            f"{{ model_name | default('Item') }} '{self.object.name}' updated successfully."
        )
        return response


class {{ model_name | default("Item") }}DeleteView(LoginRequiredMixin, DeleteView):
