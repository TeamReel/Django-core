@pytest.mark.django_db
class Test{{ model_name | default("Item") }}UpdateView:
    """Test {{ model_name | default("Item") }} update view."""

    def test_update_view_post(self, logged_in_client, sample_item):
        """Test updating {{ model_name | default('item') | lower }}."""
        url = reverse("{{ app_name }}:{{ model_name | default('item') | lower }}-update", args=[sample_item.pk])
        data = {
            "name": "Updated Name",
            "description": sample_item.description,
            "is_active": sample_item.is_active
        }
        response = logged_in_client.post(url, data)

        assert response.status_code == 302
        sample_item.refresh_from_db()
        assert sample_item.name == "Updated Name"


