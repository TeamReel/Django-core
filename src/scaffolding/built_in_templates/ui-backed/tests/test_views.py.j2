@pytest.mark.django_db
class Test{{ model_name | default("Item") }}ListView:
    """Test {{ model_name | default("Item") }} list view."""

    def test_list_view_requires_login(self, client):
        """Test list view redirects to login for unauthenticated users."""
        url = reverse("{{ app_name }}:{{ model_name | default('item') | lower }}-list")
        response = client.get(url)

        assert response.status_code == 302
        assert "/login" in response.url

    def test_list_view_shows_items(self, logged_in_client, sample_item):
        """Test list view displays items."""
        url = reverse("{{ app_name }}:{{ model_name | default('item') | lower }}-list")
        response = logged_in_client.get(url)

        assert response.status_code == 200
        assert sample_item.name in str(response.content)

    def test_list_view_search(self, logged_in_client):
        """Test list view search functionality."""
        {{ model_name | default("Item") }}.objects.create(name="Findable Item")
        {{ model_name | default("Item") }}.objects.create(name="Other Item")

        url = reverse("{{ app_name }}:{{ model_name | default('item') | lower }}-list")
        response = logged_in_client.get(url, {"search": "Findable"})

        assert response.status_code == 200
        assert "Findable Item" in str(response.content)
        assert "Other Item" not in str(response.content)


