{% raw %}<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{{ app_name | title }}{% endblock %}</title>
    
    {% load static %}
    <link rel="stylesheet" href="{% static '{{ app_name }}/css/style.css' %}">
    {% block extra_css %}{% endblock %}
</head>
<body>
    <nav class="navbar">
        <div class="container">
            <a href="{% url '{{ app_name }}:{{ model_name | default('item') | lower }}-list' %}" class="logo">
                {{ app_name | title }}
            </a>
            <ul class="nav-menu">
                <li><a href="{% url '{{ app_name }}:{{ model_name | default('item') | lower }}-list' %}">{{ model_name | default('Items') }}</a></li>
                <li><a href="{% url '{{ app_name }}:{{ model_name | default('item') | lower }}-create' %}" class="btn btn-primary">New {{ model_name | default('Item') }}</a></li>
            </ul>
        </div>
    </nav>

    <main class="container">
        {% if messages %}
            <div class="messages">
                {% for message in messages %}
                    <div class="alert alert-{{ message.tags }}">
                        {{ message }}
                    </div>
                {% endfor %}
            </div>
        {% endif %}

        {% block content %}{% endblock %}
    </main>

    <footer class="footer">
        <div class="container">
            <p>&copy; 2025 {{ app_name | title }}. Generated with django-core-scaffold.</p>
        </div>
    </footer>

    <script src="{% static '{{ app_name }}/js/main.js' %}"></script>
    {% block extra_js %}{% endblock %}
</body>
</html>{% endraw %}
