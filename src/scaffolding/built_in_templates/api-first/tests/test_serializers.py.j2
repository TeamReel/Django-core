@pytest.mark.django_db
class Test{{ model_name | default("Item") }}Serializer:
    """Test {{ model_name | default("Item") }}Serializer."""

    def test_serialize_{{ model_name | default("item") | lower }}(self):
        """Test serializing {{ model_name | default("item") | lower }} to JSON."""
        item = {{ model_name | default("Item") }}.objects.create(
            name="Test {{ model_name | default('Item') }}",
            description="Test description",
            is_active=True
        )
        serializer = {{ model_name | default("Item") }}Serializer(item)
        data = serializer.data

        assert data["name"] == "Test {{ model_name | default('Item') }}"
        assert data["description"] == "Test description"
        assert data["is_active"] is True
        assert "id" in data
        assert "created_at" in data
        assert "updated_at" in data

    def test_deserialize_valid_data(self):
        """Test deserializing valid JSON to {{ model_name | default("item") | lower }}."""
        data = {
            "name": "New {{ model_name | default('Item') }}",
            "description": "New description",
            "is_active": True
        }
        serializer = {{ model_name | default("Item") }}Serializer(data=data)

        assert serializer.is_valid()
        item = serializer.save()
        assert item.name == "New {{ model_name | default('Item') }}"

    def test_deserialize_missing_required_field(self):
        """Test deserializing data missing required field fails."""
        data = {"description": "Missing name"}
        serializer = {{ model_name | default("Item") }}Serializer(data=data)

        assert not serializer.is_valid()
        assert "name" in serializer.errors

    def test_validate_name_empty(self):
        """Test name validation rejects empty strings."""
        data = {"name": "   ", "is_active": True}
        serializer = {{ model_name | default("Item") }}Serializer(data=data)

        assert not serializer.is_valid()
        assert "name" in serializer.errors

    def test_validate_name_too_short(self):
        """Test name validation rejects short names."""
        data = {"name": "ab", "is_active": True}
        serializer = {{ model_name | default("Item") }}Serializer(data=data)

        assert not serializer.is_valid()
        assert "name" in serializer.errors

    def test_read_only_fields(self):
        """Test read-only fields cannot be set via serializer."""
        item = {{ model_name | default("Item") }}.objects.create(name="Original")
        data = {
            "id": 9999,  # Should be ignored
            "name": "Updated",
            "created_at": "2020-01-01T00:00:00Z",  # Should be ignored
        }
        serializer = {{ model_name | default("Item") }}Serializer(item, data=data, partial=True)

        assert serializer.is_valid()
        updated_item = serializer.save()
        assert updated_item.id == item.id  # Unchanged
        assert updated_item.name == "Updated"


