@pytest.mark.django_db
class TestIsOwnerOrReadOnly:
    """Test IsOwnerOrReadOnly permission."""

    def test_read_permission_for_authenticated_user(
        self, request_factory, regular_user, sample_item_with_owner
    ):
        """Test authenticated user can read any object."""
        permission = IsOwnerOrReadOnly()
        request = request_factory.get("/")
        request.user = regular_user

        assert permission.has_object_permission(
            request, None, sample_item_with_owner
        )

