@pytest.mark.django_db
class TestIsAdminOrReadOnly:
    """Test IsAdminOrReadOnly permission."""

    def test_read_permission_for_regular_user(self, request_factory, regular_user):
        """Test regular user can read."""
        permission = IsAdminOrReadOnly()
        request = request_factory.get("/")
        request.user = regular_user

        assert permission.has_permission(request, None)

    def test_write_permission_denied_for_regular_user(
        self, request_factory, regular_user
    ):
        """Test regular user cannot write."""
        permission = IsAdminOrReadOnly()
        request = request_factory.post("/")
        request.user = regular_user

        assert not permission.has_permission(request, None)

    def test_write_permission_allowed_for_admin(self, request_factory, admin_user):
        """Test admin user can write."""
        permission = IsAdminOrReadOnly()
        request = request_factory.post("/")
        request.user = admin_user

        assert permission.has_permission(request, None)

    def test_unauthenticated_user_denied(self, request_factory):
        """Test unauthenticated user denied for reads."""
        permission = IsAdminOrReadOnly()
        request = request_factory.get("/")
        request.user = None

        assert not permission.has_permission(request, None)
