@pytest.mark.django_db
class Test{{ model_name | default("Item") }}UpdateAPI:
    """Test {{ model_name | default("Item") }} update endpoint."""

    def test_update_{{ model_name | default("item") | lower }}(self, authenticated_client, sample_item):
        """Test updating {{ model_name | default("item") | lower }} with PUT."""
        url = reverse("{{ app_name }}:{{ model_name | default('item') | lower }}-detail", args=[sample_item.pk])
        data = {
            "name": "Updated {{ model_name | default('Item') }}",
            "description": "Updated description",
            "is_active": True
        }
        response = authenticated_client.put(url, data, format="json")
        
        assert response.status_code == status.HTTP_200_OK
        assert response.data["name"] == "Updated {{ model_name | default('Item') }}"
        
        sample_item.refresh_from_db()
        assert sample_item.name == "Updated {{ model_name | default('Item') }}"

    def test_partial_update_{{ model_name | default("item") | lower }}(self, authenticated_client, sample_item):
        """Test partially updating {{ model_name | default("item") | lower }} with PATCH."""
        url = reverse("{{ app_name }}:{{ model_name | default('item') | lower }}-detail", args=[sample_item.pk])
        data = {"name": "Patched Name"}
        response = authenticated_client.patch(url, data, format="json")
        
        assert response.status_code == status.HTTP_200_OK
        assert response.data["name"] == "Patched Name"
        
        sample_item.refresh_from_db()
        assert sample_item.name == "Patched Name"
        assert sample_item.description == "A test {{ model_name | default('item') | lower }}"  # Unchanged


