class {{ model_name | default("Item") }}Serializer(serializers.ModelSerializer):
    """
    Serializer for {{ model_name | default("Item") }} model.

    Provides full CRUD serialization with validation.
    """

    class Meta:
        model = {{ model_name | default("Item") }}
        fields = [
            "id",
            "name",
            "description",
            "is_active",
            "created_at",
            "updated_at",
        ]
        read_only_fields = ["id", "created_at", "updated_at"]

    def validate_name(self, value: str) -> str:
        """
        Validate name field.

        Args:
            value: Name to validate

        Returns:
            Validated name

        Raises:
            serializers.ValidationError: If name is invalid
        """
        if not value or not value.strip():
            raise serializers.ValidationError("Name cannot be empty")
        
        if len(value.strip()) < 3:
            raise serializers.ValidationError("Name must be at least 3 characters")
        
        return value.strip()


