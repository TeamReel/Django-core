# Build stage
FROM node:20-slim AS builder
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@8.15.0 --activate

WORKDIR /app

# Copy workspace configuration
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

# Copy packages and application source
COPY packages/ ./packages/
COPY demo/ ./demo/

# Install dependencies
RUN pnpm install --frozen-lockfile --prefer-offline --prod=false

# Declare build arguments (Railway injects these)
ARG VITE_API_BASE_URL
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

# Build demo + its workspace dependencies (needed because packages export from dist/)
# Use package-name filter (more reliable than path filter in CI builds).
RUN pnpm -r --filter "@django-core/demo..." build

# Production stage
FROM node:20-alpine
WORKDIR /app

# Install serve to host the static files
RUN npm install -g serve

# Copy built assets from builder stage
COPY --from=builder /app/demo/dist ./dist

# Railway injects the PORT environment variable
EXPOSE 8080

# Serve the application on 0.0.0.0:$PORT
CMD ["sh", "-c", "serve -s dist -l tcp://0.0.0.0:$PORT"]
